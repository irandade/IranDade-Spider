SPIDER_DOWNLOAD_ROOT=~/spider_downloads
SPIDER_DEFAULT_DEPTH=2
SPIDER_RATE_LIMIT=5
SPIDER_CONCURRENT_REQUESTS=8
SPIDER_DOWNLOAD_DELAY=1.0
SPIDER_RANDOMIZE_DELAY=True
SPIDER_RESPECT_ROBOTSTXT=True
SPIDER_USER_AGENTS=["Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/125.0.0.0 Safari/537.36"]
SPIDER_MAX_PATH_FILENAME_BYTES=200
